<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for the notarised macOS build.

  Notarisation requires the hardened runtime, which by default forbids things
  CPython does as a matter of course. Each entitlement below is present because
  removing it breaks the app, not as a blanket loosening:

    allow-jit / allow-unsigned-executable-memory
      CPython allocates and executes memory the runtime did not sign.
    disable-library-validation
      The bundle loads .so extension modules (pygame, PIL, cryptography) that
      are signed with our Developer ID rather than Apple's.

  Deliberately NOT granted: camera, microphone, location, address book,
  calendars-via-entitlement, disable-executable-page-protection. The app talks
  to Google Calendar over HTTPS with the user's own OAuth credentials; it needs
  no privacy-sensitive entitlement to do that.

  Spec:  docs/CODE_SIGNING.md
  Tests: tests/test_ci_contract.py::test_signing_entitlements_exist_and_are_minimal
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
